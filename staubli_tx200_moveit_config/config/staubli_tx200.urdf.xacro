<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="staubli_tx200">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import staubli_tx200 urdf file -->
    <xacro:include filename="$(find staubli_tx200_support)/urdf/tx200.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="staubli_tx200.ros2_control.xacro" />


    <xacro:staubli_tx200_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
