<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find staubli_resources)/urdf/common_materials.xacro"/>

  <xacro:macro name="staubli_tx200" params="prefix">
    <!-- links: main serial chain -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/base_link.STL"/>
        </geometry>
        <xacro:material_staubli_ral_melon_yellow />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/base_link.obj"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_1">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/link1.STL"/>
        </geometry>
        <xacro:material_staubli_ral_melon_yellow />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/link1.obj"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_2">
      <visual>
        <origin xyz="0 0 0" rpy="${radians(90)} ${radians(-90)} 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/link2.STL"/>
        </geometry>
        <xacro:material_staubli_ral_melon_yellow />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${radians(90)} ${radians(-90)} 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/link2.obj"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_3">
      <visual>
        <origin xyz="0 0 0" rpy="${radians(-90)} 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/link3.STL"/>
        </geometry>
        <xacro:material_staubli_ral_melon_yellow />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${radians(-90)} 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/link3.obj"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_4">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/link4.STL"/>
        </geometry>
        <xacro:material_staubli_ral_melon_yellow />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/link4.obj"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_5">
      <visual>
        <origin xyz="0 0 0" rpy="${radians(-90)} 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/link5.STL"/>
        </geometry>
        <xacro:material_staubli_ral_grey_aluminium />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${radians(-90)} 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/link5.obj"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_6">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/visual/link6.STL"/>
        </geometry>
        <xacro:material_staubli_ral_grey_aluminium />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://staubli_tx200_support/meshes/tx200/collision/link6.obj"/>
        </geometry>
      </collision>
    </link>

    <!-- joints: main serial chain -->
    <joint name="${prefix}joint_1" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 1"/>
      <!-- from Staubli instruction manual:
      (1) effort limit = 318 Nm if floor mounted
      (2) effort limit = 111 Nm if wall mounted -->
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="318.0" velocity="${radians(400)}" />
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}joint_2" type="revolute">
      <origin xyz="0.250 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 1 0"/>
      <limit lower="${radians(-130)}" upper="${radians(147.5)}" effort="166.0" velocity="${radians(400)}" />
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}joint_3" type="revolute">
      <origin xyz="0 0.0 0.950" rpy="0 0 0"/>
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 1 0"/>
      <limit lower="${radians(-145)}" upper="${radians(145)}" effort="76.0" velocity="${radians(430)}" />
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}joint_4" type="revolute">
      <origin xyz="0 0 0.800" rpy="0 0 0"/>
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(-270)}" upper="${radians(270)}" effort="34.0" velocity="${radians(540)}" />
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}joint_5" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 1 0"/>
      <limit lower="${radians(-115)}" upper="${radians(140)}" effort="29.0" velocity="${radians(475)}" />
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
    <joint name="${prefix}joint_6" type="revolute">
      <origin xyz="0 0 0.190" rpy="0 0 0"/>
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="0 0 1"/>
      <limit lower="${radians(-270)}" upper="${radians(270)}" effort="11.0" velocity="${radians(760)}" />
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- ROS-Industrial 'base' frame: base_link to Staubli World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 -0.642" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <!-- <link name="${prefix}flange" />
    <joint name="${prefix}joint_6-flange" type="fixed">
      <origin xyz="0 0 0" rpy="0 ${radians(-90.0)} 0" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}flange" />
    </joint> -->

    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <!-- <link name="${prefix}tool0" />
    <joint name="${prefix}flange-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="0 ${radians(90.0)} 0" />
      <parent link="${prefix}flange" />
      <child link="${prefix}tool0" />
    </joint> -->

  </xacro:macro>
</robot>
